{
  "output_dir": "${output_dir}",
  "paths": {
    "jumplion_outdir": "/path/to/jl_test/test_ms1ms2_new16",
    "sample_meta": "/path/to/jl_test/sample_meta.csv",
    "fasta": "/path/to/HYE_mix.fasta",
    "spectral_library": "/path/to/spectral_library.parquet",
    "output_dir": "/path/to/jl_test/analyses",
    "pub_dir": "${jumplion_outdir}/publication",
    "inter_dir": "${jumplion_outdir}/intermediate"
  },
  "run": ["differential_expression", "performance", "mechanism"],
  "style": {
    "font_family": ["Arial", "Helvetica", "DejaVu Sans"],
    "font_size": 8,
    "formats": ["pdf", "png"],
    "dpi": 600
  },
  "benchmark": {
    "groups": {
      "S1": "H50Y10E40",
      "S2": "H50Y20E30",
      "S3": "H50Y25E25",
      "S4": "H50Y30E20",
      "S5": "H50Y40E10"
    },
    "reference": "S1",
    "padj_cutoff": 0.05
  },
  "differential_expression": {
    "matrices": {
      "diann": {"name": "diann_norm", "file": "${pub_dir}/prec_matrix_diann_norm.tsv"},
      "jumplion": {"name": "diann_jumplion_norm", "file": "${pub_dir}/prec_matrix_diann_jumplion_norm.tsv"}
    },
    "sample_meta_file": "${sample_meta}",
    "fasta_files": ["${fasta}"],
    "mat_type": "Precursor.Id",
    "mat_sep": "\t",
    "value_start_col": 5,
    "log_transform_input": true,
    "p_adj_cutoff": 0.05,
    "log2fc_cutoff": 0.5,
    "padj_col": "p_adj",
    "log2fc_col": "log2FC",
    "overwrite": false,
    "output_dir": null
  },
  "performance": {
    "example_contrast": "S4_vs_S1"
  },
  "mechanism": {
    "xic_quant_file": "${pub_dir}/xic_quantification.parquet",
    "features_file": null,
    "overwrite_features": false,
    "rt_run_metrics": "${inter_dir}/rt_prediction/rt_cross_validation_run_metrics.tsv",
    "rt_error_histogram": "${inter_dir}/rt_prediction/rt_cross_validation_error_histogram.tsv",
    "rt_representative_run": "${inter_dir}/rt_prediction/rt_cross_validated_predictions_representative_run.tsv",
    "rt_cv_regenerate": {"rt_matrix": "${inter_dir}/rt_prediction/rt_mat_before_prediction.tsv", "library": "${spectral_library}", "min_run_fraction": 0.5},
    "rt_extraction_half_window": 0.3015,
    "rt_cv": null,
    "rt_half_window_points": 15,
    "cycle_time": 0.0201,
    "im_cv": null,
    "im_window": null,
    "im_window_table": null,
    "xic_dir": "${inter_dir}/xic_files",
    "xic_auto_selection": "median",
    "xic_examples": {
      "ms2_coelution": "SATAVAHVK2|20230731_100ACN_20min_150nl_0712Hela-Yeast-Ecoli_50-30-20_02ul_200pg_6cmHY_glass_DIA_2_1_4374",
      "ms1_peak": "AEASGEAAEEAEDEE2|20230731_100ACN_20min_150nl_0712Hela-Yeast-Ecoli_50-10-40_02ul_200pg_6cmHY_glass_DIA_2_1_4400",
      "prediction_only": null,
      "reported": null
    },
    "max_violin_kde_points": 200000,
    "signal_rank_population": "all",
    "quantity_diann": "${pub_dir}/prec_matrix_diann.tsv",
    "quantity_jumplion": "${pub_dir}/prec_matrix_jumplion.tsv",
    "mapping_metrics": "${inter_dir}/prec_quant/precursor_mapping_model_metrics.tsv",
    "min_slope": 0.5,
    "max_slope": 1.5,
    "max_mae": 0.5,
    "max_extrapolation_log2": 2,
    "species_annotation": "${output_dir}/differential_expression/diann_norm_dea_results/diann_norm_H50Y20E30_vs_H50Y10E40_pre_DE.csv"
  }
}
